# ─────────────────────────────────────────────────────────────
#  Kandahar University WMS — Root .gitignore
#  Repository is a complete backup: only generated artifacts,
#  local secrets and internal AI/dev tooling are excluded
# ─────────────────────────────────────────────────────────────

# Dependencies (generated — reinstall with `npm install`)
node_modules/

# Build outputs (generated — regenerate with `npm run build`)
dist/
dist-ssr/
build/
*.tsbuildinfo

# Compiled / source-map artifacts
*.js.map
*.d.ts.map

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets — NEVER commit real credentials
.env
.env.local
.env.*.local
!.env.example
Backend/.env
.wms-session-key
*.pem
*.key
*.pfx

# Local MySQL data directories
mysql_data/
mysql_temp_data/

# Internal AI/dev tooling & test output (not project content)
.agents/
test-results/
coverage/

# Pashto internal repair/dev notes (kept local; repo documentation is English)
REPAIR_REPORT_PASHTO.txt
FINAL_COMPARISON_REPAIR_REPORT_PASHTO.txt
FINAL_CHANGED_FILES_SHA256.txt

# AI assistant conversation dumps (dev scratch, kept local)
Frontend/attached_assets/Pasted-*

# OS / editor clutter
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
kandahar-wms/