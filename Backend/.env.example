# Windows:
#   copy Backend\.env.example Backend\.env
#
# Ubuntu/Linux:
#   cp Backend/.env.example Backend/.env
#
# The restore commands in DB/mysql-create-database.sql use kandahar_db.

PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=kandahar_db

# Optional: set this only if mysqldump is not in PATH.
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
